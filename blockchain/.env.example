# Copy this file to .env and use a Sepolia endpoint, not an Ethereum Mainnet URL.
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/your-sepolia-api-key

# Use a dedicated test wallet funded only with Sepolia test ETH.
# Never use a wallet that holds real funds and never commit the .env file.
SEPOLIA_DEPLOYER_PRIVATE_KEY=0xreplace_with_your_sepolia_test_wallet_private_key
